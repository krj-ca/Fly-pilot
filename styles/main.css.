
:root {
  --background: #071426;
  --panel: #10243b;
  --blue: #32baff;
  --text: #f3f8ff;
  --muted: #a7bbd2;
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  min-height: 100vh;
  background:
    radial-gradient(ellipse at 50% 0%, #163f65 0%, transparent 55%),
    var(--background);
  color: var(--text);
  font-family: Arial, Helvetica, sans-serif;
}

button {
  font: inherit;
}

#app {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 20px 6%;
  border-bottom: 1px solid #24415e;
  background: rgba(5, 17, 32, 0.8);
}

.brand {
  color: var(--blue);
  font-size: 22px;
  font-weight: 900;
  letter-spacing: 2px;
}

.status {
  color: #75f3bb;
  font-size: 11px;
  letter-spacing: 1px;
}

.screen {
  flex: 1;
  width: 100%;
  max-width: 1100px;
  margin: 0 auto;
  padding: 48px 6%;
}

.hero {
  padding: 28px 0;
}

.eyebrow {
  color: var(--blue);
  font-size: 12px;
  font-weight: bold;
  letter-spacing: 3px;
}

h1 {
  margin: 20px 0;
  font-size: clamp(38px, 8vw, 76px);
  line-height: 1.05;
  letter-spacing: -2px;
}

h1 span {
  color: var(--blue);
}

p {
  max-width: 520px;
  color: var(--muted);
  line-height: 1.7;
}

.menu {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14px;
  max-width: 620px;
  margin-top: 32px;
}

.menu button {
  min-height: 62px;
  padding: 16px;
  color: var(--text);
  background: linear-gradient(135deg, #173653, #10243b);
  border: 1px solid #315777;
  border-radius: 12px;
  text-align: left;
  cursor: pointer;
  transition: transform 0.2s, border-color 0.2s,
    background 0.2s;
}

.menu button:hover,
.menu button:focus-visible {
  border-color: var(--blue);
  background: #19466a;
  transform: translateY(-2px);
  outline: none;
}

.stats {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12px;
  max-width: 720px;
  margin-top: 48px;
}

.stats div {
  display: flex;
  flex-direction: column;
  gap: 9px;
  padding: 18px 12px;
  background: rgba(16, 36, 59, 0.75);
  border: 1px solid #203d59;
  border-radius: 10px;
}

.stats strong {
  color: var(--blue);
  font-size: 20px;
}

.stats span {
  color: var(--muted);
  font-size: 10px;
  letter-spacing: 1px;
}

footer {
  padding: 22px 12px;
  color: #7892ac;
  font-size: 10px;
  text-align: center;
  letter-spacing: 1.5px;
  border-top: 1px solid #203d59;
}

@media (max-width: 480px) {
  .screen {
    padding: 30px 5%;
  }

  .topbar {
    padding: 18px 5%;
  }

  .brand {
    font-size: 19px;
  }

  .menu {
    grid-template-columns: 1fr;
  }

  .stats {
    gap: 7px;
  }

  .stats div {
    padding: 14px 8px;
  }

  .stats strong {
    font-size: 16px;
  }

  .stats span {
    font-size: 9px;
    letter-spacing: 0;
  }
}
